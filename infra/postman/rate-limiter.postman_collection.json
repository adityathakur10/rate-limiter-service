      "key": "tenantId",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "ruleId",
      "value": ""
    },
    {
      "key": "unknownId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "coreUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "checkApiKey",
      "value": ""
