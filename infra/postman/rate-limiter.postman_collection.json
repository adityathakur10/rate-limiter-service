    {
      "name": "Core - check",
      "description": "POST /v1/check against a real tenant and rule created by the first two requests (5 per 60 seconds for POST /payments/send). Run top to bottom: the setup requests save checkTenantId, checkApiKey and checkRuleId, then the calls count down to a 429, a rule edit is seen by the next check, a wrong key gives 401, and an endpoint no rule covers is allowed. The last request only shows something while Redis is stopped: the check then fails open with 200 and X-RateLimit-Status: degraded.",
      "item": [
        {
          "name": "Setup: create tenant (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('checkTenantId', body.id);",
                  "pm.collectionVariables.set('checkApiKey', body.apiKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/v1/tenants",
              "host": [
                "{{adminUrl}}"
              ],
              "path": [
                "admin",
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Check Flow Tenant\"\n}"
            }
          }
        },
        {
          "name": "Setup: create rule, 5 per 60s (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('checkRuleId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminUrl}}/admin/v1/rules",
              "host": [
                "{{adminUrl}}"
              ],
              "path": [
                "admin",
                "v1",
                "rules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{checkTenantId}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\",\n  \"limit\": 5,\n  \"windowSeconds\": 60\n}"
            }
          }
        },
        {
          "name": "Check, first call (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('allowed, 4 remaining, reset time present, no retryAfter, not degraded', () => {",
                  "  pm.expect(body.allowed).to.eql(true);",
                  "  pm.expect(body.remaining).to.eql(4);",
                  "  pm.expect(body.resetAt).to.be.a('string');",
                  "  pm.expect(body).to.not.have.property('retryAfterSeconds');",
                  "  pm.expect(body).to.not.have.property('degraded');",
                  "});",
                  "pm.test('X-RateLimit headers', () => {",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('5');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('4');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Reset')).to.match(/^\\d+$/);",
                  "  pm.expect(pm.response.headers.has('X-RateLimit-Status')).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{coreUrl}}/v1/check",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "v1",
                "check"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{checkTenantId}}\",\n  \"apiKey\": \"{{checkApiKey}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\"\n}"
            }
          }
        },
        {
          "name": "Check, second call (200, remaining falls)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('3 remaining', () => {",
                  "  pm.expect(pm.response.json().remaining).to.eql(3);",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('3');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{coreUrl}}/v1/check",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "v1",
                "check"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{checkTenantId}}\",\n  \"apiKey\": \"{{checkApiKey}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\"\n}"
            }
          }
        },
        {
          "name": "Check, over the limit (429)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// calls 1 and 2 are the requests above; use up 3, 4 and 5 so this request is the 6th",
                  "const payload = JSON.stringify({ tenantId: pm.collectionVariables.get('checkTenantId'), apiKey: pm.collectionVariables.get('checkApiKey'), endpoint: '/payments/send', method: 'POST' });",
                  "for (let i = 0; i < 3; i++) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('coreUrl') + '/v1/check',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: payload }",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
                  "const body = pm.response.json();",
                  "pm.test('denied with retryAfterSeconds, no resetAt', () => {",
                  "  pm.expect(body.allowed).to.eql(false);",
                  "  pm.expect(body.remaining).to.eql(0);",
                  "  pm.expect(body.retryAfterSeconds).to.be.within(1, 60);",
                  "  pm.expect(body).to.not.have.property('resetAt');",
                  "});",
                  "pm.test('Retry-After and X-RateLimit headers', () => {",
                  "  pm.expect(pm.response.headers.get('Retry-After')).to.eql(String(body.retryAfterSeconds));",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('5');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('0');",
                  "});"
                ]
              }
            }
