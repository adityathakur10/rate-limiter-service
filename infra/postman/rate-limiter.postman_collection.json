    {
      "name": "Core - check",
      "description": "POST /v1/check against the hardcoded rule of step 2.9: 5 requests per 60 seconds per tenant. Each request in this folder uses a fresh random tenant, so the folder can be re-run any time. The api key is not validated until Stage 3.",
      "item": [
        {
          "name": "Check, first call (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('checkTenantId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('allowed, 4 remaining, reset time present, no retryAfter', () => {",
                  "  pm.expect(body.allowed).to.eql(true);",
                  "  pm.expect(body.remaining).to.eql(4);",
                  "  pm.expect(body.resetAt).to.be.a('string');",
                  "  pm.expect(body).to.not.have.property('retryAfterSeconds');",
                  "});",
                  "pm.test('X-RateLimit headers', () => {",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('5');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('4');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Reset')).to.match(/^\\d+$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{checkTenantId}}\",\n  \"apiKey\": \"{{checkApiKey}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\"\n}" },
            "url": { "raw": "{{coreUrl}}/v1/check", "host": ["{{coreUrl}}"], "path": ["v1", "check"] }
          }
        },
        {
          "name": "Check, second call (200, remaining falls)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('3 remaining', () => {",
                  "  pm.expect(pm.response.json().remaining).to.eql(3);",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('3');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{checkTenantId}}\",\n  \"apiKey\": \"{{checkApiKey}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\"\n}" },
            "url": { "raw": "{{coreUrl}}/v1/check", "host": ["{{coreUrl}}"], "path": ["v1", "check"] }
          }
        },
        {
          "name": "Check, over the limit (429)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// use up the 5 allowed calls for a fresh tenant, so the request itself is the 6th",
                  "const tenant = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('limitTenantId', tenant);",
                  "const payload = JSON.stringify({ tenantId: tenant, apiKey: pm.collectionVariables.get('checkApiKey'), endpoint: '/payments/send', method: 'POST' });",
                  "for (let i = 0; i < 5; i++) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('coreUrl') + '/v1/check',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: payload }",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
                  "const body = pm.response.json();",
                  "pm.test('denied with retryAfterSeconds, no resetAt', () => {",
                  "  pm.expect(body.allowed).to.eql(false);",
                  "  pm.expect(body.remaining).to.eql(0);",
                  "  pm.expect(body.retryAfterSeconds).to.be.within(1, 60);",
                  "  pm.expect(body).to.not.have.property('resetAt');",
                  "});",
                  "pm.test('Retry-After and X-RateLimit headers', () => {",
                  "  pm.expect(pm.response.headers.get('Retry-After')).to.eql(String(body.retryAfterSeconds));",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('5');",
                  "  pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('0');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{limitTenantId}}\",\n  \"apiKey\": \"{{checkApiKey}}\",\n  \"endpoint\": \"/payments/send\",\n  \"method\": \"POST\"\n}" },
            "url": { "raw": "{{coreUrl}}/v1/check", "host": ["{{coreUrl}}"], "path": ["v1", "check"] }
          }
        }
      ]
    },
